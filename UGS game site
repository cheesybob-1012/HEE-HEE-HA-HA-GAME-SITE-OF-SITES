        function showToast(msg) {
            const existing = document.querySelector('.toast');
            if (existing) existing.remove();
            const t = document.createElement('div');
            t.className = 'toast';
            t.textContent = msg;
            document.body.appendChild(t);
            setTimeout(() => t.remove(), 2500);
        }

        function toggleFavorite(e, game) {
            e.stopPropagation(); // Prevent launching game
            const index = favorites.indexOf(game);
            if (index === -1) {
                favorites.push(game);
                showToast("Added to Favorites ★");
            } else {
                favorites.splice(index, 1);
                showToast("Removed from Favorites");
            }
            localStorage.setItem('ugs_favorites', JSON.stringify(favorites));
            render(document.getElementById('search-input').value);
        }

        function openGame(file) {
            const normalized = file.includes('.') ? file : file + '.html';
            const url = `https://cdn.jsdelivr.net/gh/bubbls/ugs-singlefile/UGS-Files/${encodeURIComponent(normalized)}`;
            showToast(`Launching ${file.startsWith('cl') ? file.substring(2) : file}...`);

            fetch(url)
                .then(res => {
                    if (!res.ok) throw new Error('Not found');
                    return res.text();
                })
                .then(html => {
                    const win = window.open("about:blank", "_blank");
                    if (!win) {
                        alert("Enable pop-ups to play.");
                        return;
                    }
                    win.document.open();
                    win.document.write(html);
                    win.document.close();
                })
                .catch(() => alert(`Error: Could not load "${normalized}".`));
        }

        function getFileCharacter(file) {
            let name = file.toLowerCase();
            if (name.startsWith('cl')) name = name.substring(2);
            const first = name[0]?.toUpperCase();
            return /^[A-Z0-9]$/.test(first) ? first : '#';
        }

        function getCleanName(file) {
            return file.startsWith('cl') ? file.substring(2) : file;
        }

        function render(searchTerm = "") {
            const container = document.getElementById('sections-container');
            const sidebar = document.getElementById('sidebar');
            container.innerHTML = '';
            sidebar.innerHTML = '';
            scrollObserver.disconnect();
            focusIndex = -1; // Reset keyboard focus

            const filtered = files.filter(f => getCleanName(f).toLowerCase().includes(searchTerm.toLowerCase()));
            document.getElementById('game-counter').textContent = `(${filtered.length} games)`;

            const groups = {};
            allChars.forEach(c => groups[c] = []);

            // Populate favorites if no active search
            if (searchTerm === "") {
                favorites.forEach(f => groups['★'].push(f));
            }

            filtered.forEach(f => {
                const char = getFileCharacter(f);
                groups[char].push(f);
            });

            allChars.forEach(char => {
                const list = groups[char];
                
                const sBtn = document.createElement('button');
                sBtn.className = 'sidebar-btn' + (list.length === 0 ? ' empty' : '');
                sBtn.textContent = char;
                sBtn.dataset.char = char;
                if (list.length > 0) {
                    sBtn.onclick = () => {
                        const target = document.getElementById(`section-${char}`);
                        if (target) target.scrollIntoView({behavior: 'smooth'});
                    };
                }
                sidebar.appendChild(sBtn);

                if (list.length === 0) return;

                const sec = document.createElement('div');
                sec.id = `section-${char}`;
                sec.className = 'letter-section';
                
                const headerText = char === '★' ? 'Favorites' : char;
                sec.innerHTML = `<div class="letter-header">${headerText}</div>`;
                
                const grid = document.createElement('div');
                grid.className = 'buttons-grid';

                list.forEach(game => {
                    const cleanName = getCleanName(game);
                    const isFav = favorites.includes(game);
                    const iconLetter = cleanName[0]?.toUpperCase() || '#';

                    const btn = document.createElement('div');
                    btn.className = 'game-btn';
                    btn.title = game;
                    btn.onclick = () => openGame(game);
                    
                    btn.innerHTML = `
                        <div class="game-icon">${iconLetter}</div>
                        <div class="game-title">${cleanName}</div>
                        <button class="fav-btn ${isFav ? 'is-fav' : ''}">★</button>
                        <div class="play-indicator">Play →</div>
                    `;

                    btn.querySelector('.fav-btn').onclick = (e) => toggleFavorite(e, game);
                    grid.appendChild(btn);
                });

                sec.appendChild(grid);
                container.appendChild(sec);
                scrollObserver.observe(sec);
            });
        }

        // Random Game Logic
        document.getElementById('random-btn').onclick = () => {
            if (files.length > 0) {
                const random = files[Math.floor(Math.random() * files.length)];
                openGame(random);
            }
        };

        // Theme Switcher Logic
        const themeSwitcher = document.getElementById('theme-switcher');
        themeSwitcher.onchange = (e) => {
            document.body.setAttribute('data-theme', e.target.value);
            localStorage.setItem('ugs_theme', e.target.value);
        };
        const savedTheme = localStorage.getItem('ugs_theme');
        if (savedTheme) {
            document.body.setAttribute('data-theme', savedTheme);
            themeSwitcher.value = savedTheme;
        }

        // Search & Keyboard Nav Logic
        const searchInput = document.getElementById('search-input');
        const clearBtn = document.getElementById('clear-search');

        searchInput.addEventListener('input', (e) => {
            clearBtn.style.display = e.target.value ? 'block' : 'none';
            render(e.target.value);
        });

        clearBtn.onclick = () => {
            searchInput.value = '';
            clearBtn.style.display = 'none';
            render();
            searchInput.focus();
        };

        document.addEventListener('keydown', (e) => {
            const visibleBtns = Array.from(document.querySelectorAll('.game-btn'));
            if (!visibleBtns.length) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                focusIndex = (focusIndex + 1) % visibleBtns.length;
                updateFocus(visibleBtns);
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                focusIndex = (focusIndex - 1 + visibleBtns.length) % visibleBtns.length;
                updateFocus(visibleBtns);
            } else if (e.key === 'Enter' && focusIndex >= 0 && document.activeElement !== searchInput) {
                visibleBtns[focusIndex].click();
            }
        });

        function updateFocus(btns) {
            btns.forEach(b => b.classList.remove('focused'));
            if(focusIndex >= 0 && btns[focusIndex]) {
                btns[focusIndex].classList.add('focused');
                btns[focusIndex].scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        window.onscroll = () => {
            document.getElementById('back-to-top').style.display = window.scrollY > 400 ? 'block' : 'none';
        };
        document.getElementById('back-to-top').onclick = () => window.scrollTo({top: 0, behavior: 'smooth'});

        render();
