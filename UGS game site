    <style>
        :root {
            /* Default Theme Variables */
            --primary: #5986da;
            --hover: #79aadb;
            --bg1: #2b3044;
            --bg2: #1a1c23;
            --text-main: #e0e0e0;
            --card-bg: rgba(255, 255, 255, 0.05);
            --card-hover: rgba(255, 255, 255, 0.1);
            --border: rgba(255, 255, 255, 0.1);
            --sidebar-width: 80px;
        }

        [data-theme="cyberpunk"] {
            --primary: #ff00ff;
            --hover: #ff66ff;
            --bg1: #090014;
            --bg2: #1a001a;
            --text-main: #00ffff;
            --card-bg: rgba(0, 255, 255, 0.05);
            --card-hover: rgba(0, 255, 255, 0.15);
            --border: rgba(255, 0, 255, 0.3);
        }

        [data-theme="matrix"] {
            --primary: #00ff00;
            --hover: #66ff66;
            --bg1: #000000;
            --bg2: #051405;
            --text-main: #00cc00;
            --card-bg: rgba(0, 255, 0, 0.05);
            --card-hover: rgba(0, 255, 0, 0.15);
            --border: rgba(0, 255, 0, 0.2);
        }

        [data-theme="attempt1"] {
            --primary: #b01212;
            --hover: #b30000;
            --bg1: #000000;
            --bg2: #000000;
            --text-main: lightslategray;
            --card-bg: #470000;
            --card-hover: #690000;
            --border: #b01212;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(45deg, var(--bg1), var(--bg2), var(--bg1));
            background-size: 200% 200%;
            animation: gradientBG 15s ease infinite;
            color: var(--text-main);
            margin: 0;
            display: flex;
            min-height: 100vh;
            min-width: 1200px;
            overflow-x: auto;
            transition: color 0.3s, background 0.3s;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Sidebar Navigation */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(12px);
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 20px 10px;
            overflow-y: auto;
            border-right: 1px solid var(--border);
            z-index: 1000;
        }

        .sidebar::-webkit-scrollbar { width: 4px; }
        .sidebar::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 10px; }

        .sidebar-btn {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-main);
            padding: 8px 0;
            font-size: 14px;
            font-weight: 700;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'Orbitron', sans-serif;
        }

        .sidebar-btn:hover:not(.empty) {
            background: var(--primary);
            color: #fff;
            transform: translateX(5px);
        }

        .sidebar-btn.active {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 0 10px var(--primary);
            transform: scale(1.1);
        }

        .sidebar-btn.empty { opacity: 0.2; cursor: default; border: none; }

        /* Main Content */
        .main-content {
            margin-left: var(--sidebar-width);
            flex: 1;
            padding: 60px;
            width: 1000px;
            margin-right: auto;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 50px;
            border-left: 5px solid var(--primary);
            padding-left: 30px;
        }

        .header-left h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 3.5rem;
            margin: 0 0 10px 0;
            letter-spacing: -1px;
            color: var(--primary);
            text-shadow: 0 0 15px rgba(0,0,0,0.5);
        }

        #game-counter {
            font-size: 1.2rem;
            font-family: 'Inter', sans-serif;
            color: var(--text-main);
            opacity: 0.8;
            font-weight: normal;
        }

        .header-links a {
            color: var(--hover);
            text-decoration: none;
            margin-right: 25px;
            font-weight: 600;
            transition: color 0.3s;
        }

        .header-links a:hover { color: var(--primary); text-shadow: 0 0 8px var(--primary); }

        #theme-switcher {
            background: var(--card-bg);
            color: var(--text-main);
            border: 1px solid var(--border);
            padding: 10px 15px;
            border-radius: 8px;
            font-family: 'Inter', sans-serif;
            font-weight: bold;
            cursor: pointer;
            outline: none;
        }

        /* Search Bar & Controls */
        .controls-wrapper {
            display: flex;
            gap: 15px;
            margin-bottom: 60px;
            align-items: center;
        }

        .search-box {
            position: relative;
            flex: 1;
        }

        #search-input {
            width: 100%;
            padding: 20px 50px 20px 30px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: rgba(0, 0, 0, 0.4);
            color: var(--text-main);
            font-size: 1.2rem;
            outline: none;
            transition: all 0.3s;
            backdrop-filter: blur(5px);
        }

        #search-input:focus { 
            border-color: var(--primary);
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
        }

        #clear-search {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            color: var(--text-main);
            font-size: 1.5rem;
            cursor: pointer;
            display: none;
            opacity: 0.5;
        }

        #clear-search:hover { opacity: 1; color: var(--primary); }

        #random-btn {
            background: var(--primary);
            color: #fff;
            border: none;
            padding: 0 30px;
            height: 65px;
            border-radius: 12px;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            transition: 0.2s;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            white-space: nowrap;
        }

        #random-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.5);
            background: var(--hover);
        }

        /* Grid & Sections */
        .letter-section { margin-bottom: 80px; scroll-margin-top: 40px; }
        
        .letter-header {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.5rem;
            font-weight: 900;
            color: var(--primary);
            margin-bottom: 30px;
            border-bottom: 1px solid var(--border);
            padding-bottom: 10px;
        }

        .buttons-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .game-btn {
            background: var(--card-bg);
            border: 1px solid var(--card-bg);
            padding: 12px 20px;
            border-radius: 12px;
            color: var(--text-main);
            cursor: pointer;
            text-align: left;
            transition: all 0.2s ease;
            font-size: 1.2rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .game-btn.focused,
        .game-btn:hover {
            background: var(--card-hover);
            border-color: var(--primary);
            transform: translateX(10px);
        }

        .game-icon {
            width: 45px;
            height: 45px;
            background: var(--primary);
            color: #fff;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }

        .game-title { flex: 1; }

        .fav-btn {
            font-size: 1.8rem;
            color: rgba(255,255,255,0.2);
            background: transparent;
            border: none;
            cursor: pointer;
            transition: 0.2s;
            padding: 0 10px;
        }

        .fav-btn:hover { transform: scale(1.2); }
        .fav-btn.is-fav { color: #ffd700; text-shadow: 0 0 10px #ffd700; opacity: 1; }
        
        [data-theme="cyberpunk"] .fav-btn.is-fav { color: #fff; text-shadow: 0 0 10px #ff00ff, 0 0 20px #ff00ff; }
        [data-theme="matrix"] .fav-btn.is-fav { color: #fff; text-shadow: 0 0 10px #00ff00, 0 0 20px #00ff00; }

        .play-indicator {
            font-size: 0.9rem;
            opacity: 0;
            transform: translateX(-10px);
            transition: all 0.2s;
            color: var(--primary);
            font-weight: bold;
        }

        .game-btn.focused .play-indicator,
        .game-btn:hover .play-indicator {
            opacity: 1;
            transform: translateX(0);
        }

        .toast {
            position: fixed;
            top: 30px;
            right: 30px;
            background: var(--primary);
            color: #fff;
            padding: 15px 30px;
            border-radius: 8px;
            font-weight: 600;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            z-index: 10000;
        }

        #back-to-top {
            position: fixed;
            bottom: 40px;
            right: 40px;
            width: 60px;
            height: 60px;
            background: var(--card-bg);
            border: 2px solid var(--primary);
            border-radius: 50%;
            color: var(--primary);
            font-size: 24px;
            cursor: pointer;
            display: none;
            backdrop-filter: blur(10px);
            transition: all 0.3s;
        }

        #back-to-top:hover {
            background: var(--primary);
            color: #fff;
        }

        [data-theme="attempt1"] .game-btn { border-color: var(--border); }
        [data-theme="attempt1"] .fav-btn.is-fav {
            color: #fff;
            text-shadow: 0 0 10px var(--primary), 0 0 20px var(--primary);
        }
    </style>
</head>
