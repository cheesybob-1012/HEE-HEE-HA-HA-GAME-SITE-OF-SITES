function getCleanName(file) {
    return file.startsWith('cl') ? file.substring(2) : file;
}

function getLetter(file) {
    const first = getCleanName(file)[0]?.toUpperCase();
    return /^[A-Z]$/.test(first) ? first : '#';
}

function renderGames(searchTerm = '') {
    const query = searchTerm.trim().toLowerCase();
    const sections = Array.from(document.querySelectorAll('.letter-section'));
    const gamesByLetter = new Map(sections.map(section => [
        section.id.slice('letter-'.length).toUpperCase(),
        []
    ]));
    const filteredGames = ugsGames.filter(file =>
        `${getCleanName(file)} ${file}`.toLowerCase().includes(query)
    );

    filteredGames.forEach(file => {
        const games = gamesByLetter.get(getLetter(file));
        if (games) games.push(file);
    });

    sections.forEach(section => {
        const letter = section.id.slice('letter-'.length).toUpperCase();
        const games = gamesByLetter.get(letter);
        const isEmpty = games.length === 0;
        section.hidden = isEmpty;
        section.open = Boolean(query) && !isEmpty;

        const separator = section.nextElementSibling;
        if (separator?.tagName === 'HR') separator.hidden = isEmpty;

        const content = section.querySelector('.letter-content-inner');
        content.replaceChildren();
        const buttons = document.createDocumentFragment();
        games.forEach(file => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'game-entry';
            button.textContent = getCleanName(file);
            button.title = file;
            button.addEventListener('click', () => openGame(file));
            buttons.appendChild(button);
        });
        content.appendChild(buttons);

        const sidebarLink = Array.from(document.querySelectorAll('.sidebar a'))
            .find(link => link.getAttribute('href') === `#${section.id}`);
        if (sidebarLink) {
            sidebarLink.hidden = isEmpty;
            if (sidebarLink.nextElementSibling?.tagName === 'BR') {
                sidebarLink.nextElementSibling.hidden = isEmpty;
            }
        }
    });

    document.getElementById('game-count').textContent =
        `${filteredGames.length} of ${ugsGames.length} games`;
}

function openGame(file) {
    const normalized = file.includes('.') ? file : `${file}.html`;
    const url = `https://cdn.jsdelivr.net/gh/bubbls/ugs-singlefile/UGS-Files/${encodeURIComponent(normalized)}`;
    const win = window.open('about:blank', '_blank');
    if (!win) {
        alert('Enable pop-ups to play.');
        return;
    }

    fetch(url)
        .then(response => {
            if (!response.ok) throw new Error(`Request failed: ${response.status}`);
            return response.text();
        })
        .then(html => {
            if (win.closed) return;
            win.document.open();
            win.document.write(html);
            win.document.close();
        })
        .catch(error => {
            console.error(`Could not load "${normalized}".`, error);
            if (!win.closed) win.close();
            alert(`Error: Could not load "${normalized}".`);
        });
}

document.getElementById('game-search').addEventListener('input', event => {
    renderGames(event.target.value);
});

renderGames();
